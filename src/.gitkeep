import pandas as pd
import numpy as np

# قراءة البيانات
df = pd.read_csv("memoire_ids/data/raw/Monday-WorkingHours.pcap_ISCX.csv")

print("Shape:", df.shape)

# عرض أسماء الأعمدة
print("\nColumns:")
print(df.columns)

# حساب القيم المفقودة
print("\nMissing values:")
print(df.isnull().sum().sort_values(ascending=False).head(10))

# البحث عن Infinity
numeric_df = df.select_dtypes(include=[np.number])
print("\nInfinite values:")
print(np.isinf(numeric_df).sum().sort_values(ascending=False).head(10))

# توزيع Label
print("\nLabel distribution:")
print(df[" Label"].value_counts())


#--------------------------------------------------------------------------------------


# استبدال القيم اللانهائية بـ NaN
df.replace([np.inf, -np.inf], np.nan, inplace=True)

# حذف الصفوف التي تحتوي على NaN
df_clean = df.dropna()

print("Shape after cleaning:", df_clean.shape)

# فصل الخصائص عن Label
X = df_clean.drop(" Label", axis=1)
y = df_clean[" Label"]

print("Features shape:", X.shape)
print("Labels shape:", y.shape)